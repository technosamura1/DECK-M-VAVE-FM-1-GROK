# a new empty song, the piano: REC with a count-in, a few chords, a second pass, undo, redo
wait 300
tap SAVE
wait 100
expect page 6
tapkey w4
wait 200
expect nev 0
press HOME
tapkey b0
release HOME
wait 50
wait 100
expect track 0
expect seq 0
expect clicks 0
# the part's BARS set by hand (4): the tape's AUTO off, takes loop at 4 bars
tap SEQ
tap SEQ
turn K2 1
turn K2 -1
wait 50
expect bars 4
tap REC
wait 200
expect counting >0
expect recording 0
expect page 7
shot tape_count.png
wait 3300
expect recording 1
expect playing 1
expect clicks >3
key w0 down 90
wait 900
key w0 up
wait 400
key w3 down 80
wait 1200
shot tape_rec.png
key w3 up
wait 400
key w4 down 80
wait 800
key w4 up
wait 9000
expect pass >1
key w5 down 100
wait 600
key w5 up
wait 300
tap REC
wait 200
expect recording 0
expect events >8
press LFO
wait 800
release LFO
wait 100
expect events >8
expect undo >0
# the metronome: REC only, so playing alone it is quiet
tap PLAY
wait 300
expect playing 0
tap PLAY
wait 2000
tap PLAY
wait 300
# saved by itself in the silence (once in 5 min at most, the first at once); a reboot brings it back
wait 92000
expect dirty 0
reboot
wait 300
expect nev >8
expect track 0
# a small change saved again (only its sectors rewritten): the project still loads whole
press HOME
tapkey w3
release HOME
wait 8000
expect dirty 1
wait 296000
expect dirty 0
reboot
wait 300
expect nev >8
expect track 0
# the road: two blocks, SONG
tap ENV
wait 100
tapkey w0
tapkey w0
wait 100
expect nroad >0
# the click is OFF by default (the count-in still clicks); HOME+REC: ON REC, again: off
press HOME
tap REC
release HOME
wait 50
expect metro 1
press HOME
tap REC
release HOME
wait 50
expect metro 0
# the clip's operations (EDIT list, white 9 COPY CLIP, white 4 DOUBLE); HOME + OCT: transpose
tap HOME
wait 50
press HOME
tapkey b0
release HOME
wait 50
page 11
tap LFO
tapkey w8
wait 50
tapkey w3
wait 100
tap LFO
expect events >16
press HOME
tap OCT+
release HOME
wait 50
