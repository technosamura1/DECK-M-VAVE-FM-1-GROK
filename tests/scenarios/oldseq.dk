# the old sequencers fold away on load: LIVE (1), DREAM (4), FINGER (5), HOLD (6), TOMBOLA (7) become SEQ (0); ENDLESS (2) stays
wait 300
tap SAVE
wait 100
tapkey w4
wait 200
page 0
press HOME
tapkey b0
release HOME
wait 50
reseq 1 7
expect seq 0
reseq 1 1
expect seq 0
reseq 1 6
expect seq 0
reseq 1 4
expect seq 0
reseq 1 5
expect seq 0
reseq 1 2
expect seq 2
