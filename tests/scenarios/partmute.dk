# PER-PART TRACK MUTES: in MIX a white key 1-6 mutes that track IN THE PART (a bit of the part, saved with the project). Stopped: at once;
# playing: it waits for the bar's end (pending, blinking); HOME + white: at once; SEQ + white: the old global (temporary) mute;
# holding a white key 1 s still clears that clip. Each part has its own mask.
wait 300
tap SAVE
wait 100
tapkey w4
wait 200
expect nev 0
listen
seed 0 1 4 1
seed 0 2 4 0
seed 1 1 2 0
setbars 0 2
page 3
wait 100
expect page 3
expect pmask 0
# stopped: at once, toasts A: <track> MUTED / ON
tapkey w0
wait 100
expect pmask 1
said MUTED
tapkey w0
wait 100
expect pmask 0
said ON
tapkey w1
wait 100
expect pmask 2
expect pmaskB 0
expect tmute0 0
# playing: the toggle waits for the bar's end
tap PLAY
wait 300
expect playing 1
tapkey w0
wait 100
expect pmpend 1
expect pmask 2
said BAR END
# toggled again before the bar's end: cancelled (nothing pending)
tapkey w0
wait 100
expect pmpend 0
tapkey w0
wait 100
expect pmpend 1
wait 3400
expect pmpend 0
expect pmask 3
expect part 0
# HOME + white: at once, even playing
press HOME
tapkey w0
release HOME
wait 100
expect pmask 2
expect pmpend 0
# SEQ + white: the global (temporary) mute, not the part's
press SEQ
tapkey w0
release SEQ
wait 100
expect tmute0 1
expect pmask 2
said TEMP
press SEQ
tapkey w0
release SEQ
wait 100
expect tmute0 0
# holding the key 1 s clears the clip, and does not toggle the mute
expect eventsA2 4
key w1 down 90
wait 1200
key w1 up
wait 100
expect eventsA2 0
expect pmask 2
# another part has its own mask: B is asked for, at the bar's end the song is in B, whose mask is 0
press ARP
tapkey w1
release ARP
wait 4700
expect part 1
expect pmask 0
expect pmaskA 2
# pending while stopping: applied
tapkey w3
wait 100
expect pmpend 8
tap PLAY
wait 300
expect playing 0
expect pmpend 0
expect pmaskB 8
# NEW PART = EMPTY does not touch masks; the masks are saved with the project and come back
wait 92000
expect dirty 0
reboot
wait 300
expect pmaskA 2
expect pmaskB 8
expect pmaskC 0
