# ARP: a new hand (the first key after all were let go) starts the pattern again from its first step
wait 300
tap FX
tap ARP
wait 100
key w0 down
key w2 down
wait 1500
expect arpstep >3
key w0 up
key w2 up
wait 300
expect arpstep >3
key w0 down
wait 40
expect arpstep <2
wait 1500
expect arpstep >3
# a second key to the same hand does not restart it
key w4 down
wait 40
expect arpstep >3
key w0 up
key w4 up
wait 300
# LATCH (ARP page, K4): the notes stay after letting go and the pattern runs on; a new hand restarts it
turn K4 1
wait 100
key w1 down
key w3 down
wait 800
key w1 up
key w3 up
wait 800
expect arpstep >3
key w5 down
wait 40
expect arpstep <2
key w5 up
