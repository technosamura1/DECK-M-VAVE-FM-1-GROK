# SELECT while REC onto a track that already has a take: the new notes are their own layer.
# before: they joined the old take, and holding REC to erase the new one took the old notes too.
wait 300
tap SAVE
wait 100
tapkey w4
wait 200
press HOME
tapkey b0
release HOME
tap SEQ
tap SEQ
turn K2 1
turn K2 -1
wait 50
turn SELECT 1
wait 80
expect track 1
tap REC
wait 4000
expect recording 1
expect pass 1
key w0 down 90
wait 250
key w0 up
wait 300
tap REC
wait 300
expect recording 0
expect nlay 1
expect evlay 1
expect events 4
turn SELECT -1
wait 80
expect track 0
expect events 0
tap REC
wait 4000
expect recording 1
expect pass 1
expect recmask 1
turn SELECT 1
wait 120
expect track 1
expect recmask 3
key w2 down 90
wait 250
key w2 up
wait 400
tap REC
wait 400
expect recording 0
expect nlay 2
expect evlay 1
expect events 8
expect inv 0
# erase the take just recorded: the old layer stays
press REC
wait 800
release REC
wait 300
expect recording 0
expect events 4
expect nlay 1
expect evlay 1
expect inv 0
