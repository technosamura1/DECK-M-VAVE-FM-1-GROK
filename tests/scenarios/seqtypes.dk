# the sequencers: ARP (over LIVE), TOMBOLA, FINGER, DRIVE (and BAKE); FILL
wait 300
# a new empty song: the tape's tracks (PIANO PAD KEYS BASS DRUMS NATURE: LIVE LIVE LIVE STEP FINGER LIVE)
tap SAVE
wait 100
tapkey w4
wait 200
tap HOME
wait 100
press HOME
tapkey b1
release HOME
wait 50
expect track 1
expect seq 1
# ARP over LIVE on the keys
tap ARP
wait 100
expect seq 1
key w0 down 90
key w2 down 90
wait 1000
expect voices >0
key w0 up
key w2 up
wait 300
press HOME
tap ARP
release HOME
wait 50
# TOMBOLA on the keys (SEQ held + white 5)
press SEQ
tapkey w4
release SEQ
wait 50
expect seq 7
tap PLAY
tapkey w2
tapkey w5
tapkey w7
wait 4000
expect tmb >2
shot tombola.png
tap PLAY
wait 200
# FINGER on the drums: a pattern held
press HOME
tapkey b4
release HOME
wait 50
expect seq 5
key w6 down 90
wait 1500
expect voices >0
shot finger.png
key w6 up
# DRIVE on the drums, then BAKE it to STEP
press SEQ
tapkey w2
release SEQ
wait 50
expect seq 4
tap HOME
wait 50
tap SEQ
wait 100
turn K2 1
wait 100
shot drive.png
tap PLAY
wait 2000
press HOME
tap SEQ
release HOME
wait 50
wait 17000
expect seq 0
expect events >4
tap PLAY
wait 200
# FILL held while playing
tap PLAY
wait 500
press GLO
wait 450
expect fill 1
release GLO
wait 100
expect fill 0
tap PLAY
