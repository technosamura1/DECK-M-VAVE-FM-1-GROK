# the sequencers: SEQ (a clip, as a DAW's; the drums a grid) with ARP over it, ENDLESS (OP-1's); FILL
wait 300
# a new empty song: every track SEQ
tap SAVE
wait 100
tapkey w4
wait 200
tap HOME
wait 100
press HOME
tapkey b1
release HOME
wait 50
expect track 1
expect seq 0
# ARP over SEQ on the keys (the button opens the page; K4 there switches it on)
tap ARP
wait 100
turn K4 1
wait 50
expect seq 0
key w0 down 90
key w2 down 90
wait 1000
expect voices >0
key w0 up
key w2 up
wait 300
press HOME
tap ARP
release HOME
wait 50
# the drums (the 5th track): a key sounds while the song plays, and REC writes it (FINGER took the keys once: silence)
press HOME
tapkey b4
release HOME
wait 50
expect seq 0
tap HOME
tap PLAY
wait 500
key w0 down 100
wait 10
expect tvoices5 >0
key w0 up
wait 200
qnt 0
tap REC
wait 4000
key w1 down 100
wait 10
expect tvoices5 >0
key w1 up
wait 3000
tap REC
wait 300
expect eventsA5 >0
tap PLAY
wait 300
# ENDLESS on the piano: REC, five steps played in (a chord is one step), a rest, a tie; REC done
press HOME
tapkey b0
release HOME
wait 50
seqtype 1
wait 50
expect seq 2
tap REC
wait 50
expect endlon 1
expect page 1
key w0 down 90
wait 30
key w0 up
wait 100
key w2 down 90
key w4 down 90
wait 50
key w2 up
key w4 up
wait 100
tap OCT-
wait 50
key w4 down 90
wait 30
key w4 up
tap OCT+
wait 50
key w1 down 90
wait 30
key w1 up
wait 50
tap REC
wait 50
expect endlon 0
expect endlsteps 6
expect textfit 0
wait 1500
shot endless.png
# it goes round by itself
tap PLAY
wait 2000
expect voices >0
# a key transposes it (the first step's note to the key)
tap HOME
wait 50
key w1 down 90
wait 30
key w1 up
wait 50
expect endltr >0
expect endlsteps 6
wait 1000
tap PLAY
wait 300
# FILL is no longer GLO: holding it does not start a fill
tap PLAY
wait 500
press GLO
wait 450
expect fill 0
release GLO
tap PLAY
wait 200
expect textfit 0
