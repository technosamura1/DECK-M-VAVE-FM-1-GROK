tapkey w2
wait 100
expect track 2
expect pmask 0
tapkey b2
wait 100
expect pmask 4
tapkey b2
wait 100
expect pmask 0
tapkey b6
wait 100
expect solo2 1
tapkey b6
wait 100
expect solo2 0
tapkey b7
wait 100
expect armtrk 4
tapkey b7
wait 100
expect armtrk 0
page 11
tapkey w5
wait 100
expect track 5
tapkey b1
wait 100
expect pmask 2
tapkey b1
wait 100
expect pmask 0
tapkey b6
wait 100
expect solo5 1
tapkey b6
wait 100
expect solo5 0
# REC held 1.2 s with nothing else: no take, nothing erased
mark
press REC
wait 1200
release REC
wait 200
expect recording 0
expect counting 0
expect same 1
expect textfit 0
