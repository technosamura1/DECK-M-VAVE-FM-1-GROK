# REC + hold ENV + SELECT: an empty part gets a copy of this one NOW (notes, frozen sound, bars, mutes).
# The loop does not jump back to the start, and the take keeps recording on top of the copy.
# A part that already has notes is not overwritten.
listen
wait 300
tap SAVE
wait 100
tapkey w4
wait 200
expect nev 0
press HOME
tapkey b0
release HOME
wait 50
expect track 0
seed 0 1 4 2
setbars 0 4
expect eventsA1 4
expect eventsB1 0
expect barsA 4
tap PLAY
wait 800
expect playing 1
expect part 0
expect ptick >20
tap REC
wait 200
expect recording 1
expect page 7
press ENV
turn SELECT 1
release ENV
wait 200
expect garage 0
expect part 1
expect next -1
expect recording 1
expect playing 1
expect ptick >20
said A->B
expect eventsB1 4
expect eventsA1 4
expect barsB 4
expect psndB1 2
expect nev 8
expect track 0
# the note played after the branch is only in B
key w0 down 100
wait 500
key w0 up
wait 500
expect eventsA1 4
expect eventsB1 >4
expect track 0
# C already has notes: SELECT does not copy over it and does not leave B
seed 2 1 2 0
press ENV
turn SELECT 1
release ENV
wait 150
expect part 1
expect eventsC1 2
said HAS NOTES
# SELECT alone is still the track
turn SELECT 1
wait 80
expect track 1
expect recording 1
