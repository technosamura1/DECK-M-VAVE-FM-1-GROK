# REC LAT: the same take played twice (the same press, the same time after the count-in), once with no latency made up
# for and once with 30 ms: the second is earlier, by about 30 ms in ticks (a tick at 76 BPM is 8.2 ms), its length the same
wait 300
tap SAVE
wait 100
tapkey w4
wait 200
press HOME
tapkey b0
release HOME
wait 100
expect track 0
expect lat 9
tap SEQ
tap SEQ
turn K2 1
turn K2 -1
wait 50
expect bars 4
qnt 0
lat 0
tap REC
wait 3500
expect recording 1
wait 700
key w0 down 90
wait 700
key w0 up
wait 300
tap REC
wait 300
expect recording 0
expect events 4
expect evpos 133
# the second track, the same take, 30 ms made up for
tap PLAY
wait 300
expect playing 0
press HOME
tapkey b1
release HOME
wait 100
expect track 1
qnt 0
lat 30
tap REC
wait 3500
expect recording 1
wait 700
key w0 down 90
wait 700
key w0 up
wait 300
tap REC
wait 300
expect recording 0
expect events 4
expect evpos 128
# the note that starts a take (ON NOTE) is at the take's start, whatever the latency
tap PLAY
wait 300
press HOME
tapkey b2
release HOME
wait 100
expect track 2
qnt 0
lat 30
onnote 1
tap REC
wait 300
expect playing 0
key w0 down 90
wait 500
key w0 up
wait 300
tap REC
wait 300
expect recording 0
expect events 4
expect evpos 0
# the setting through the page: GLO, its fourth row, K1
onnote 0
tap GLO
tap GLO
tap GLO
tap GLO
turn K1 -1
wait 50
expect lat 29
