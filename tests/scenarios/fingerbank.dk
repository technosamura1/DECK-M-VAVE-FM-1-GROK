# FINGER's banks: LOFI 8BIT SYNTH CINEMA (K1 of the FINGER row), a bank per track, saved with the project
wait 300
tap SAVE
wait 100
tapkey w4
wait 200
tap HOME
wait 100
# the drums: FINGER
press HOME
tapkey b4
release HOME
wait 50
expect seq 5
tap SEQ
wait 100
expect page 1
expect fbank 0
shot fbank_lofi.png
turn K1 1
wait 100
expect fbank 1
shot fbank_8bit.png
key w6 down 90
wait 1500
expect voices >0
key w6 up
turn K1 1
wait 100
expect fbank 2
shot fbank_synth.png
turn K1 1
wait 100
expect fbank 3
shot fbank_cinema.png
# the end stops
turn K1 1
expect fbank 3
turn K1 -3
expect fbank 0
turn K1 2
wait 100
# every pattern of every bank plays, FILL too (hold GLO)
key w0 down 90
wait 400
key w0 up
key w9 down 90
wait 400
key w9 up
press GLO
key w12 down 90
wait 600
key w12 up
release GLO
wait 300
# a bank per track: the other track is on LOFI, the drums keep theirs
press HOME
tapkey b1
release HOME
wait 100
expect track 1
expect fbank 0
expect fbank4 2
press HOME
tapkey b4
release HOME
wait 100
expect fbank 2
# melodic FINGER on the bass (the BASS track), its banks
press HOME
tapkey b3
release HOME
wait 100
press SEQ
tapkey w3
release SEQ
wait 100
expect seq 5
turn K1 1
wait 100
expect fbank 1
expect fbank3 1
key w4 down 90
wait 1200
expect voices >0
key w4 up
turn K1 2
wait 100
expect fbank 3
key w8 down 90
wait 1200
key w8 up
shot fbank_bass_cinema.png
# saved, rebooted: the banks come back
wait 92000
expect dirty 0
reboot
wait 300
expect fbank4 2
expect fbank3 3
expect fbank0 0
